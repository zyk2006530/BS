# Copy this file to .env and fill values locally. Empty values MUST fail Compose.
# Never commit .env or paste resolved Compose environment / docker inspect output.
# Account names are fixed by deploy/mysql/init/01-accounts.sh; only passwords are configurable.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
MYSQL_MIGRATION_PASSWORD=
# Generate a random secret (>=32 bytes); keep stable across backend replicas/restarts.
APP_CSRF_SECRET=
# Local development only. Production must use an exact HTTPS origin and Secure cookies.
APP_WEB_ORIGIN=http://127.0.0.1:8088
APP_COOKIE_SECURE=false
