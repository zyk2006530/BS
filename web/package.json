    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "2.2.12"
